# Patterns to ignore when building packages.
.git/
.gitignore
.DS_Store
*.orig
*.bak
*.swp
.vscode/

# Chart development/test artifacts, not needed in the packaged chart. `ci/` is where
# chart-testing looks for the values files it lints and installs with; those are fixtures for this
# repository's CI, not something a consumer of the packaged chart has any use for.
ci/
README.md.gotmpl
